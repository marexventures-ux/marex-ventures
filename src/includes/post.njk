---
layout: base.njk
---
<style>
  .toc-container {
    display: none;
    background: var(--surface-color);
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    padding: 1.5rem 2rem;
    margin-bottom: 2.5rem;
    box-shadow: var(--shadow-soft);
    transition: var(--transition);
  }
  .toc-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    user-select: none;
  }
  .toc-title {
    margin: 0;
    font-size: 1.15rem;
    color: var(--accent-navy);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .toc-toggle-btn {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 600;
  }
  .toc-list ul {
    list-style: none;
    padding-left: 0;
    margin: 1rem 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .toc-list ul li a {
    color: var(--text-main);
    text-decoration: none;
    transition: color 0.2s, transform 0.2s;
    display: inline-block;
  }
  .toc-list ul li a:hover {
    color: var(--accent-red);
    transform: translateX(4px);
  }

  /* Dark Theme Contrast Enhancement */
  [data-theme="dark"] .toc-container {
    background: #112542 !important;
    border: 1px solid rgba(255, 255, 255, 0.12) !important;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  }
  [data-theme="dark"] .toc-title {
    color: #FFFFFF !important;
  }
  [data-theme="dark"] .toc-toggle-btn {
    color: #94A3B8 !important;
  }
  [data-theme="dark"] .toc-list ul li a {
    color: #E2E8F0 !important;
  }
  [data-theme="dark"] .toc-list ul li a:hover {
    color: #FF5A5F !important;
  }
</style>

<section class="container section" style="padding-top: 150px; max-width: 800px; margin: 0 auto;">
  <div class="floating-card" style="padding: 4rem; margin-bottom: 2rem;">
    <a href="/blog/" style="display: inline-block; margin-bottom: 2rem; color: var(--accent-red); text-decoration: none; font-weight: 600;">&larr; Back to Blog</a>
    <h1 style="font-size: 2.5rem; margin-bottom: 1rem; color: var(--accent-navy);">{{ title }}</h1>
    <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 2rem; border-bottom: 1px solid var(--glass-border); padding-bottom: 2rem;">Published by Marex Ventures</p>
    {% if image %}
    <img src="{{ image }}" alt="{{ title }}" style="width: 100%; max-height: 420px; object-fit: cover; border-radius: 12px; margin-bottom: 2.5rem;">
    {% endif %}

    <!-- Auto-Generated Table of Contents Container -->
    <div id="toc-container" class="toc-container">
      <div class="toc-header" onclick="toggleTOC()">
        <h3 class="toc-title">
          <span>📑</span> Table of Contents
        </h3>
        <span id="toc-toggle-icon" class="toc-toggle-btn">[Hide]</span>
      </div>
      <nav id="toc-list" class="toc-list">
        <ul></ul>
      </nav>
    </div>

    <div class="blog-content" style="line-height: 1.8; color: var(--text-main); font-size: 1.1rem;">
      {{ content | safe }}
    </div>
  </div>
</section>

<script>
  // Dynamic Table of Contents Generator for SEO & Jump Links
  document.addEventListener("DOMContentLoaded", function() {
    var content = document.querySelector(".blog-content");
    var tocContainer = document.getElementById("toc-container");
    var tocList = document.querySelector("#toc-list ul");
    if (!content || !tocContainer || !tocList) return;

    var headings = content.querySelectorAll("h2, h3");
    if (headings.length < 2) return; // Only show if article has at least 2 headings

    headings.forEach(function(heading, index) {
      if (!heading.id) {
        var slug = heading.textContent.trim().toLowerCase()
          .replace(/[^a-z0-9]+/g, "-")
          .replace(/(^-|-$)/g, "");
        heading.id = slug || ("section-" + index);
      }

      var li = document.createElement("li");
      var isH3 = heading.tagName.toLowerCase() === "h3";
      li.style.paddingLeft = isH3 ? "1.5rem" : "0";
      li.style.fontSize = isH3 ? "0.95rem" : "1rem";

      var a = document.createElement("a");
      a.href = "#" + heading.id;
      a.textContent = heading.textContent;

      li.appendChild(a);
      tocList.appendChild(li);
    });

    tocContainer.style.display = "block";
  });

  function toggleTOC() {
    var list = document.querySelector("#toc-list ul");
    var icon = document.getElementById("toc-toggle-icon");
    if (list.style.display === "none") {
      list.style.display = "flex";
      icon.textContent = "[Hide]";
    } else {
      list.style.display = "none";
      icon.textContent = "[Show]";
    }
  }
</script>
