---
layout: base.njk
title: Blog | Marex Ventures
description: Thoughts on custom software, AI automation, and scaling modern businesses.
eleventyExcludeFromCollections: true
---

<section class="container section" style="padding-top: 150px; padding-bottom: 4rem;">
  <div style="text-align: center; margin-bottom: 4rem;">
    <h1 style="margin-bottom: 1rem;">Insights & <span class="text-gradient">Case Studies</span></h1>
    <p style="font-size: 1.2rem; max-width: 600px; margin: 0 auto; color: var(--text-muted);">
      Strategies for scaling operations, automating workflows, and building exact systems.
    </p>
  </div>

  <!-- Interactive Category Filter Bar -->
  <div class="category-filter-bar">
    <button class="category-btn active" onclick="filterCategory(this, 'all')">All Articles</button>
    <button class="category-btn" onclick="filterCategory(this, 'Business Automation')">Business Automation</button>
    <button class="category-btn" onclick="filterCategory(this, 'Systems & Operations')">Systems & Operations</button>
    <button class="category-btn" onclick="filterCategory(this, 'Custom Software')">Custom Software</button>
    <button class="category-btn" onclick="filterCategory(this, 'AI & Digital Tools')">AI & Digital Tools</button>
    <button class="category-btn" onclick="filterCategory(this, 'SME Growth & Strategy')">SME Growth</button>
    <button class="category-btn" onclick="filterCategory(this, 'Case Studies')">Case Studies</button>
  </div>

  <div class="grid grid-cols-3" style="gap: 2rem;" id="blog-grid">
    {% for post in collections.blog %}
    {% set postCat = post.data.category | default("Business Automation") %}
    <div class="floating-card blog-post-card" data-category="{{ postCat }}" style="padding: 0; overflow: hidden; display: flex; flex-direction: column;">
      {% if post.data.image %}
      <img src="{{ post.data.image }}" alt="{{ post.data.title }}" style="width: 100%; height: 200px; object-fit: cover;">
      {% endif %}
      <div style="padding: 2rem; display: flex; flex-direction: column; flex: 1;">
        <div style="margin-bottom: 0.75rem;">
          <span class="badge-tag">{{ postCat }}</span>
        </div>
        <h3 style="margin-bottom: 0.75rem; font-size: 1.25rem; line-height: 1.4;">
          <a href="{{ post.url }}" style="color: var(--accent-navy); text-decoration: none;">{{ post.data.title }}</a>
        </h3>
        <p style="font-size: 0.95rem; color: var(--text-muted); margin-bottom: 1.25rem; line-height: 1.6; flex: 1;">{{ post.data.description }}</p>
        
        {% if post.data.post_tags %}
        <div class="post-tags-container" style="margin-bottom: 1.25rem;">
          {% for tag in post.data.post_tags.split(',') %}
            {% if tag | trim %}
            <span class="post-tag">#{{ tag | trim }}</span>
            {% endif %}
          {% endfor %}
        </div>
        {% endif %}

        <div style="margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--glass-border); display: flex; justify-content: space-between; align-items: center;">
          <span style="font-size: 0.85rem; color: var(--text-muted);">{{ post.date | default(post.data.date) | date("MMM d, yyyy") if false else "" }}</span>
          <a href="{{ post.url }}" style="color: var(--accent-red); text-decoration: none; font-weight: bold; font-size: 0.95rem;">Read Article &rarr;</a>
        </div>
      </div>
    </div>
    {% else %}
    <p style="grid-column: span 3; text-align: center; color: var(--text-muted);">More insights coming soon.</p>
    {% endfor %}

    <div id="no-posts-msg" style="display: none; grid-column: span 3; text-align: center; color: var(--text-muted); padding: 3rem 0; font-size: 1.1rem;">
      No articles found in this category yet. Check back soon!
    </div>
  </div>

  <script>
    function filterCategory(btn, category) {
      document.querySelectorAll('.category-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const cards = document.querySelectorAll('.blog-post-card');
      let visibleCount = 0;
      cards.forEach(card => {
        const cardCat = card.getAttribute('data-category');
        if (category === 'all' || cardCat === category) {
          card.removeAttribute('data-hidden');
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.setAttribute('data-hidden', 'true');
          card.style.display = 'none';
        }
      });
      const noPostsMsg = document.getElementById('no-posts-msg');
      if (noPostsMsg) {
        noPostsMsg.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }
  </script>
</section>
